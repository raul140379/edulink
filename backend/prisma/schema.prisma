generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  id              Int              @id @default(autoincrement())
  name            String
  location        String?
  logoUrl         String?
  emailDomain     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  schools         School[]
  users           User[]
  juntaMembers    JuntaMember[]
  gobiernoMembers GobiernoMember[]
  nucleos         Nucleo[]
  comunicados     Comunicado[]
}

model Nucleo {
  id              Int              @id @default(autoincrement())
  name            String
  location        String?
  districtId      Int
  district        District         @relation(fields: [districtId], references: [id])
  schools         School[]
  users           User[]
  juntaMembers    JuntaMember[]
  gobiernoMembers GobiernoMember[]
  comunicados     Comunicado[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([name, districtId])
}

model School {
  id         Int             @id @default(autoincrement())
  name       String
  sieCode    String          @unique
  tipo       SchoolType
  area       SchoolArea
  subsistema Subsistema      @default(REGULAR)
  // Niveles que ofrece el colegio (uno o varios: INICIAL/PRIMARIA/SECUNDARIA —
  // mismo enum AcademicLevel que ya usa Course, pero acá es un array porque un
  // colegio puede tener varios niveles a la vez). offersBTH solo tiene sentido
  // si SECUNDARIA está entre los niveles (Bachillerato Técnico Humanístico es
  // una variante de Secundaria, no un nivel aparte) — no se fuerza por schema,
  // se valida en school.service.ts.
  levels     AcademicLevel[] @default([])
  offersBTH  Boolean         @default(false)
  // Turno(s) en que funciona el colegio (uno o varios) — mismo enum Shift que
  // ya usa Course/ShiftDirector, acá como array por la misma razón que levels.
  shifts     Shift[]         @default([])
  address    String?
  isActive   Boolean         @default(true)
  districtId Int
  nucleoId   Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  district   District        @relation(fields: [districtId], references: [id])
  nucleo     Nucleo?         @relation(fields: [nucleoId], references: [id])

  schoolSchedules         SchoolSchedule[]
  users                   User[]
  juntaMembers            JuntaMember[]
  gobiernoMembers         GobiernoMember[]
  comunicados             Comunicado[]
  shiftDirectors          ShiftDirector[]
  directors               Director[]
  academicYears           AcademicYear[]
  parents                 Parent[]
  students                Student[]
  teachers                Teacher[]
  staff                   Staff[]
  courses                 Course[]
  classrooms              Classroom[]
  subjects                Subject[]
  charges                 Charge[]
  mandatoryCharges        MandatoryCharge[]
  payments                Payment[]
  notifications           Notification[]
  meetings                Meeting[]
  tasks                   Task[]
  notas                   Nota[]
  schedules               Schedule[]
  schedulePlans           SchedulePlan[]
  gateRecords             GateRecord[]
  teacherAttendances      TeacherAttendance[]
  studentAttendances      StudentAttendance[]
  biometricTemplates      BiometricTemplate[]
  poaActas                PoaActa[]
  studentGamifications    StudentGamification[]
  studentAchievements     StudentAchievement[]
  studentTrimesterBonuses StudentTrimesterBonus[]
  convocatorias           Convocatoria[]
  parentKardexHistory     ParentKardexHistory[]
  refunds                 Refund[]
  auditLogs               AuditLog[]
  sportsParticipants      SportsParticipant[]
}

model SchoolSchedule {
  id             Int      @id @default(autoincrement())
  shift          String
  name           String
  exitTime       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  breakAfter     String   @default("2,4")
  breakDuration  Int      @default(15)
  isWinter       Boolean  @default(false)
  periodDuration Int      @default(40)
  periods        Int      @default(7)
  startTime      String
  schoolId       Int
  school         School   @relation(fields: [schoolId], references: [id])
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  password                String
  role                    Role
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  schoolId                Int?
  districtId              Int?
  nucleoId                Int?
  createdByUserId         Int?
  school                  School?                  @relation(fields: [schoolId], references: [id])
  district                District?                @relation(fields: [districtId], references: [id])
  nucleo                  Nucleo?                  @relation(fields: [nucleoId], references: [id])
  createdBy               User?                    @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers            User[]                   @relation("UserCreatedBy")
  juntaMember             JuntaMember?
  gobiernoMember          GobiernoMember?
  meetingsCreated         Meeting[]                @relation("MeetingCreator")
  notificationsSent       Notification[]           @relation("NotificationSender")
  comunicados             Comunicado[]             @relation("ComunicadoAuthor")
  parentDelegate          Parent?                  @relation("ParentDelegate")
  parent                  Parent?                  @relation("ParentUser")
  director                ShiftDirector?
  schoolDirector          Director?
  staff                   Staff?
  student                 Student?
  teacherTutor            Teacher?                 @relation("TeacherTutor")
  teacher                 Teacher?                 @relation("TeacherUser")
  poaActasCreated         PoaActa[]
  convocatoriasCreated    Convocatoria[]           @relation("ConvocatoriaCreator")
  convocatoriaAttendances ConvocatoriaAttendance[]
  academicYearsClosed     AcademicYear[]           @relation("AcademicYearEconomicClosedBy")
  refundsHandled          Refund[]
  auditLogsActed          AuditLog[]
  sportsParticipantsAdded SportsParticipant[]

  @@index([schoolId])
}

model JuntaMember {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  ci           String?   @unique
  phone        String?
  juntaRole    JuntaRole @default(VOCAL)
  academicYear Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  userId       Int       @unique
  // Padre/tutor del que proviene este miembro — nullable a nivel de esquema
  // (no rompe filas ya creadas de Núcleo/Distrito), pero obligatorio en la
  // práctica para cualquier alta/edición de nivel JUNTA_ESCOLAR (validado en
  // junta.service.ts): un directivo de colegio siempre tiene que ser el tutor
  // (ParentStudent.isTutor=true) de algún estudiante ya registrado.
  parentId     Int?
  schoolId     Int?
  nucleoId     Int?
  districtId   Int?
  user         User      @relation(fields: [userId], references: [id])
  parent       Parent?   @relation(fields: [parentId], references: [id])
  school       School?   @relation(fields: [schoolId], references: [id])
  nucleo       Nucleo?   @relation(fields: [nucleoId], references: [id])
  district     District? @relation(fields: [districtId], references: [id])
}

// Junta directiva del Gobierno Estudiantil (Presidente/Vicepresidente/...), en sus 3
// niveles (colegio/núcleo/distrito) — análogo a JuntaMember pero para STUDENT_GOV/
// GOBIERNO_NUCLEO/GOBIERNO_DISTRITO, que hasta ahora no tenían ningún concepto de cargo.
model GobiernoMember {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  ci           String?   @unique
  phone        String?
  cargo        JuntaRole @default(VOCAL)
  academicYear Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  userId       Int       @unique
  schoolId     Int?
  nucleoId     Int?
  districtId   Int?
  user         User      @relation(fields: [userId], references: [id])
  school       School?   @relation(fields: [schoolId], references: [id])
  nucleo       Nucleo?   @relation(fields: [nucleoId], references: [id])
  district     District? @relation(fields: [districtId], references: [id])
}

model ShiftDirector {
  id       Int      @id @default(autoincrement())
  shift    Shift
  userId   Int      @unique
  schoolId Int
  courses  Course[]
  user     User     @relation(fields: [userId], references: [id])
  school   School   @relation(fields: [schoolId], references: [id])

  @@unique([shift, schoolId])
}

model AcademicYear {
  id                  Int                         @id @default(autoincrement())
  year                Int
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  schoolId            Int
  // Cierre económico (Junta Escolar) — independiente de isActive, que
  // controla el ciclo académico y lo maneja Dirección. Null = todavía
  // abierta económicamente.
  economicClosedAt    DateTime?
  economicClosedById  Int?
  economicClosedBy    User?                       @relation("AcademicYearEconomicClosedBy", fields: [economicClosedById], references: [id])
  school              School                      @relation(fields: [schoolId], references: [id])
  charges             Charge[]
  mandatoryCharges    MandatoryCharge[]
  holidays            Holiday[]
  schedules           Schedule[]
  schedulePlans       SchedulePlan[]
  assignments         StudentAcademicAssignment[]
  studentAttendances  StudentAttendance[]
  trimesters          Trimester[]
  parentKardexHistory ParentKardexHistory[]
  sportsParticipants  SportsParticipant[]

  @@unique([year, schoolId])
}

// Kardex histórico de un tutor por gestión — aditivo, no reemplaza
// Parent.kardex (el vigente). Sirve para dejar constancia consultable de
// qué kardex tenía un tutor en una gestión cerrada (ej. import histórico).
model ParentKardexHistory {
  id             Int          @id @default(autoincrement())
  parentId       Int
  academicYearId Int
  kardex         String
  schoolId       Int
  createdAt      DateTime     @default(now())
  parent         Parent       @relation(fields: [parentId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])

  @@unique([parentId, academicYearId])
  @@unique([kardex, academicYearId, schoolId])
}

model Trimester {
  id               Int                     @id @default(autoincrement())
  number           Int
  name             String?
  startDate        DateTime
  endDate          DateTime
  academicYearId   Int
  isClosed         Boolean                 @default(false)
  notas            Nota[]
  tasks            Task[]
  academicYear     AcademicYear            @relation(fields: [academicYearId], references: [id])
  trimesterBonuses StudentTrimesterBonus[]

  @@unique([academicYearId, number])
}

model Holiday {
  id             Int          @id @default(autoincrement())
  date           DateTime
  description    String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
}

model Parent {
  id               Int                   @id @default(autoincrement())
  firstName        String
  lastName         String
  ci               String?
  phone            String?
  address          String?
  email            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  userId           Int?                  @unique
  delegateUserId   Int?                  @unique
  attendanceCode   String?
  kardex           String?
  schoolId         Int
  school           School                @relation(fields: [schoolId], references: [id])
  attendances      Attendance[]
  charges          Charge[]
  delegateCourse   Course?               @relation("CourseDelegate")
  notifications    Notification[]
  delegateUser     User?                 @relation("ParentDelegate", fields: [delegateUserId], references: [id])
  user             User?                 @relation("ParentUser", fields: [userId], references: [id])
  students         ParentStudent[]
  payments         Payment[]
  juntaMemberships JuntaMember[]
  kardexHistory    ParentKardexHistory[]

  @@unique([ci, schoolId])
  @@unique([email, schoolId])
  @@unique([attendanceCode, schoolId])
  @@unique([kardex, schoolId])
  @@index([schoolId])
}

model Student {
  id                   Int                         @id @default(autoincrement())
  firstName            String
  lastName             String
  ci                   String?
  rude                 String?
  birthDate            DateTime?
  phone                String?
  email                String?
  isActive             Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  userId               Int?                        @unique
  address              String?
  gender               Gender                      @default(MASCULINO)
  kardex               String?
  schoolId             Int
  school               School                      @relation(fields: [schoolId], references: [id])
  charges              Charge[]
  notas                Nota[]
  parents              ParentStudent[]
  user                 User?                       @relation(fields: [userId], references: [id])
  assignments          StudentAcademicAssignment[]
  studentAttendances   StudentAttendance[]
  taskSubmissions      TaskSubmission[]
  gateRecords          GateRecord[]
  gamification         StudentGamification?
  achievements         StudentAchievement[]
  trimesterBonuses     StudentTrimesterBonus[]
  sportsParticipations SportsParticipant[]

  @@unique([ci, schoolId])
  @@unique([rude, schoolId])
  @@unique([email, schoolId])
  @@index([schoolId])
}

model ParentStudent {
  id           Int          @id @default(autoincrement())
  relationType RelationType @default(OTRO)
  isTutor      Boolean      @default(false)
  parentId     Int
  studentId    Int
  parent       Parent       @relation(fields: [parentId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Teacher {
  id                 Int                    @id @default(autoincrement())
  firstName          String
  lastName           String
  ci                 String?
  phone              String?
  email              String?
  specialty          String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  userId             Int                    @unique
  birthDate          DateTime?
  hoursLoad          Int?
  gender             String?
  tutorUserId        Int?                   @unique
  attendanceCode     String?
  entryTime          String?
  exitTime           String?
  toleranceMin       Int                    @default(10)
  schoolId           Int
  school             School                 @relation(fields: [schoolId], references: [id])
  biometricTemplate  BiometricTemplate[]
  tutorCourse        CourseTutor?
  gateRecords        GateRecord[]
  notas              Nota[]
  studentAttendances StudentAttendance[]
  tasks              Task[]
  tutorUser          User?                  @relation("TeacherTutor", fields: [tutorUserId], references: [id])
  user               User                   @relation("TeacherUser", fields: [userId], references: [id])
  attendances        TeacherAttendance[]
  specialties        TeacherSpecialty[]
  assignments        TeacherSubjectCourse[]

  @@unique([ci, schoolId])
  @@unique([email, schoolId])
  @@unique([attendanceCode, schoolId])
}

model TeacherSpecialty {
  id        Int     @id @default(autoincrement())
  teacherId Int
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model TeacherAttendance {
  id        Int              @id @default(autoincrement())
  teacherId Int
  date      DateTime         @default(now())
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENTE)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  schoolId  Int
  school    School           @relation(fields: [schoolId], references: [id])
  teacher   Teacher          @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
  @@index([schoolId])
}

model Staff {
  id                Int                 @id @default(autoincrement())
  firstName         String
  lastName          String
  ci                String?
  phone             String?
  staffRole         StaffRole
  shift             Shift?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  userId            Int                 @unique
  attendanceCode    String?
  schoolId          Int
  school            School              @relation(fields: [schoolId], references: [id])
  biometricTemplate BiometricTemplate[]
  gateRecord        GateRecord[]
  user              User                @relation(fields: [userId], references: [id])

  @@unique([ci, schoolId])
  @@unique([attendanceCode, schoolId])
}

// Perfil del Director de una unidad educativa (mismo patrón que Teacher/Staff:
// User genérico + tabla de perfil con nombre). Se permite más de una fila por
// schoolId a lo largo del tiempo (reemplazos), pero el service garantiza que
// solo una quede isActive=true por colegio a la vez — no es una restricción de
// base de datos porque Postgres no soporta un unique parcial vía Prisma directo.
model Director {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  ci        String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  userId    Int      @unique
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Course {
  id                 Int                         @id @default(autoincrement())
  level              AcademicLevel
  grade              Grade
  parallel           Parallel
  educationType      EducationType               @default(REGULAR)
  shift              Shift
  shiftDirectorId    Int?
  delegateId         Int?                        @unique
  schoolId           Int
  school             School                      @relation(fields: [schoolId], references: [id])
  delegate           Parent?                     @relation("CourseDelegate", fields: [delegateId], references: [id])
  shiftDirector      ShiftDirector?              @relation(fields: [shiftDirectorId], references: [id])
  tutor              CourseTutor?
  meetings           Meeting[]
  notas              Nota[]
  schedules          Schedule[]
  schedulePlans      SchedulePlan[]
  assignments        StudentAcademicAssignment[]
  studentAttendances StudentAttendance[]
  tasks              Task[]
  teacherSubjects    TeacherSubjectCourse[]

  @@unique([level, grade, parallel, educationType, shift, schoolId])
}

model CourseTutor {
  id        Int      @id @default(autoincrement())
  courseId  Int      @unique
  teacherId Int      @unique
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
}

/// /MATERIAL_ESCOLAR
model Subject {
  id                 Int                    @id @default(autoincrement())
  name               String
  code               String?
  level              AcademicLevel
  hoursPerWeek       Int                    @default(4)
  campo              CampoSaber?
  isActive           Boolean                @default(true)
  schoolId           Int
  school             School                 @relation(fields: [schoolId], references: [id])
  notas              Nota[]
  gradeConfigs       SubjectGradeConfig[]
  tasks              Task[]
  teacherSpecialties TeacherSpecialty[]
  teacherSubjects    TeacherSubjectCourse[]

  @@unique([name, level, schoolId])
}

model SubjectGradeConfig {
  id            Int           @id @default(autoincrement())
  subjectId     Int
  grade         Grade
  hoursPerWeek  Int
  educationType EducationType @default(REGULAR)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, grade, educationType])
}

model TeacherSubjectCourse {
  id            Int            @id @default(autoincrement())
  teacherId     Int
  subjectId     Int
  courseId      Int
  schedules     Schedule[]
  schedulePlans SchedulePlan[]
  course        Course         @relation(fields: [courseId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  teacher       Teacher        @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, subjectId, courseId])
}

model Task {
  id            Int              @id @default(autoincrement())
  title         String
  description   String?
  type          TaskType
  maxScore      Float
  dueDate       DateTime?
  courseId      Int
  subjectId     Int
  teacherId     Int
  trimesterId   Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  attachmentUrl String?
  schoolId      Int
  school        School           @relation(fields: [schoolId], references: [id])
  notaItems     NotaItem[]
  course        Course           @relation(fields: [courseId], references: [id])
  subject       Subject          @relation(fields: [subjectId], references: [id])
  teacher       Teacher          @relation(fields: [teacherId], references: [id])
  trimester     Trimester?       @relation(fields: [trimesterId], references: [id])
  submissions   TaskSubmission[]
}

model TaskSubmission {
  id          Int        @id @default(autoincrement())
  taskId      Int
  studentId   Int
  score       Float?
  note        String?
  status      TaskStatus @default(PENDIENTE)
  submittedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  student     Student    @relation(fields: [studentId], references: [id])
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
}

// Gamificación del panel Estudiante: XP/nivel + racha (1:1 con Student), catálogo de
// logros global + desbloqueados por estudiante, y bonus de XP idempotente por cierre
// de trimestre. Ver backend/src/services/gamification.service.ts para la lógica.
model StudentGamification {
  id             Int       @id @default(autoincrement())
  studentId      Int       @unique
  xp             Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastStreakDate DateTime?
  schoolId       Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  student        Student   @relation(fields: [studentId], references: [id])
  school         School    @relation(fields: [schoolId], references: [id])
}

model AchievementDefinition {
  id            Int                  @id @default(autoincrement())
  code          String               @unique
  name          String
  description   String
  icon          String
  criteriaKey   String
  criteriaValue Float?
  createdAt     DateTime             @default(now())
  unlocks       StudentAchievement[]
}

model StudentAchievement {
  id            Int                   @id @default(autoincrement())
  studentId     Int
  achievementId Int
  unlockedAt    DateTime              @default(now())
  schoolId      Int
  student       Student               @relation(fields: [studentId], references: [id])
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id])
  school        School                @relation(fields: [schoolId], references: [id])

  @@unique([studentId, achievementId])
}

model StudentTrimesterBonus {
  id          Int       @id @default(autoincrement())
  studentId   Int
  trimesterId Int
  xpAwarded   Int
  awardedAt   DateTime  @default(now())
  schoolId    Int
  student     Student   @relation(fields: [studentId], references: [id])
  trimester   Trimester @relation(fields: [trimesterId], references: [id])
  school      School    @relation(fields: [schoolId], references: [id])

  @@unique([studentId, trimesterId])
}

model StudentAcademicAssignment {
  id             Int           @id @default(autoincrement())
  educationType  EducationType
  year           Int
  studentId      Int
  courseId       Int
  academicYearId Int
  createdAt      DateTime      @default(now())
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  course         Course        @relation(fields: [courseId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYearId, educationType])
  @@index([academicYearId])
}

model Schedule {
  id                     Int                  @id @default(autoincrement())
  dayOfWeek              Int
  startTime              String
  endTime                String
  courseId               Int
  teacherSubjectCourseId Int
  academicYearId         Int
  period                 Int
  status                 String               @default("BORRADOR")
  classroomId            Int?
  schoolId               Int
  school                 School               @relation(fields: [schoolId], references: [id])
  academicYear           AcademicYear         @relation(fields: [academicYearId], references: [id])
  classroom              Classroom?           @relation(fields: [classroomId], references: [id])
  course                 Course               @relation(fields: [courseId], references: [id])
  teacherSubjectCourse   TeacherSubjectCourse @relation(fields: [teacherSubjectCourseId], references: [id])

  @@unique([courseId, academicYearId, dayOfWeek, period])
}

model SchedulePlan {
  id                     Int                  @id @default(autoincrement())
  dayOfWeek              Int
  period                 Int
  startTime              String
  endTime                String
  courseId               Int
  academicYearId         Int
  teacherSubjectCourseId Int
  classroomId            Int?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  slot                   String               @default("TEMP")
  schoolId               Int
  school                 School               @relation(fields: [schoolId], references: [id])
  academicYear           AcademicYear         @relation(fields: [academicYearId], references: [id])
  classroom              Classroom?           @relation(fields: [classroomId], references: [id])
  course                 Course               @relation(fields: [courseId], references: [id])
  teacherSubjectCourse   TeacherSubjectCourse @relation(fields: [teacherSubjectCourseId], references: [id])

  @@unique([courseId, academicYearId, dayOfWeek, period, slot])
}

model Classroom {
  id            Int            @id @default(autoincrement())
  name          String
  capacity      Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  schoolId      Int
  school        School         @relation(fields: [schoolId], references: [id])
  schedules     Schedule[]
  schedulePlans SchedulePlan[]

  @@unique([name, schoolId])
}

model Charge {
  id                      Int              @id @default(autoincrement())
  title                   String
  description             String?
  amount                  Float
  paidAmount              Float            @default(0)
  type                    ChargeType
  status                  ChargeStatus     @default(PENDIENTE)
  dueDate                 DateTime?
  createdAt               DateTime         @default(now())
  parentId                Int
  academicYearId          Int
  studentId               Int?
  target                  ChargeTarget     @default(TUTOR)
  tolerance               Boolean          @default(false)
  toleranceNote           String?
  // Import CSV por curso: "recibo" con texto tipo TRANF/banca móvil (transferencia
  // sin número confirmado) — el cargo queda PENDIENTE (no cuenta como recaudado),
  // pero esta nota lo distingue de un "no pagó" normal en Verificación por Curso.
  // No-null ES el flag (sin booleano aparte); se limpia sola al corregir el cargo
  // con un pago real (ver correctHistoricalCharge).
  pendingVerificationNote String?
  updatedAt               DateTime         @updatedAt
  schoolId                Int
  // Si este cargo fue generado desde una plantilla de "cargo obligatorio",
  // referencia a esa plantilla — permite saber quién ya lo tiene y no
  // duplicarlo (ver MandatoryCharge).
  mandatoryChargeId       Int?
  // Si este cargo nació de un traslado de deuda (cierre económico de una
  // gestión anterior), referencia al cargo origen — trazabilidad real y
  // consultable, no solo una nota de texto.
  sourceChargeId          Int?
  school                  School           @relation(fields: [schoolId], references: [id])
  academicYear            AcademicYear     @relation(fields: [academicYearId], references: [id])
  parent                  Parent           @relation(fields: [parentId], references: [id])
  student                 Student?         @relation(fields: [studentId], references: [id])
  mandatoryCharge         MandatoryCharge? @relation(fields: [mandatoryChargeId], references: [id])
  sourceCharge            Charge?          @relation("ChargeCarriedForward", fields: [sourceChargeId], references: [id])
  carriedCharges          Charge[]         @relation("ChargeCarriedForward")
  payments                Payment[]
  refunds                 Refund[]

  @@index([schoolId])
  @@index([parentId])
  @@index([academicYearId])
  @@index([studentId])
}

// Devolución interna de un pago duplicado (ej. el tutor pagó dos veces por
// error, con dos recibos distintos) — puramente informativa/aditiva: NUNCA
// toca Charge.status ni Charge.paidAmount, el cargo se queda PAGADO tal cual
// (el dinero sí se recibió, solo que después se devolvió una parte o el
// total). No se ata a un Payment puntual porque el segundo pago duplicado
// muchas veces ni siquiera generó su propio Payment en el sistema
// (registerPayment ya rechaza un pago nuevo sobre un cargo PAGADO) — la
// devolución es sobre el CARGO, no sobre una fila de pago específica.
model Refund {
  id          Int      @id @default(autoincrement())
  amount      Float
  date        DateTime @default(now())
  reason      String
  chargeId    Int
  charge      Charge   @relation(fields: [chargeId], references: [id])
  handledById Int?
  handledBy   User?    @relation(fields: [handledById], references: [id])
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())
}

enum AuditAction {
  DELETE
  OVERWRITE
}

// Bitácora genérica de acciones destructivas (borrado/sobrescritura) — no
// pensada para mostrarse en ninguna pantalla de familia, solo consulta de
// soporte/SUPER_ADMIN. `before`/`after` guardan una foto de los campos
// relevantes en el momento de la acción, no el registro completo (ver
// CLAUDE.md 17.1). Aditiva, sin relación con ParentKardexHistory/Refund
// (esas sí son dato de negocio mostrado en pantalla; esta no).
model AuditLog {
  id          Int         @id @default(autoincrement())
  action      AuditAction
  entityType  String
  entityId    Int
  before      Json?
  after       Json?
  reason      String?
  actorUserId Int?
  actor       User?       @relation(fields: [actorUserId], references: [id])
  schoolId    Int
  school      School      @relation(fields: [schoolId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([schoolId])
  @@index([actorUserId])
}

// Deportista que representa al colegio en una disciplina de los Juegos
// Estudiantiles Municipales. Un mismo estudiante puede tener varias filas
// (una por disciplina) — el único índice único es sobre la combinación
// completa (estudiante + disciplina + gestión), para evitar un duplicado
// exacto por doble clic, nunca para limitar a una disciplina por estudiante.
model SportsParticipant {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id])
  discipline     String
  modality       String?
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  createdById    Int?
  createdBy      User?        @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([studentId, discipline, academicYearId])
  @@index([schoolId])
  @@index([academicYearId])
}

// Plantilla de cargo obligatorio — al crearla se aplica de inmediato a todos
// los tutores actuales que aún no la tengan, y automáticamente a todo tutor
// nuevo que se registre mientras esté activa (ver parentService.createParent
// y mandatoryChargeService). Siempre target=TUTOR (igual que el cargo masivo).
model MandatoryCharge {
  id             Int          @id @default(autoincrement())
  title          String
  description    String?
  amount         Float
  type           ChargeType
  dueDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  academicYearId Int
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  charges        Charge[]
}

model Payment {
  id           Int           @id @default(autoincrement())
  amount       Float
  reference    String?
  date         DateTime      @default(now())
  createdAt    DateTime      @default(now())
  chargeId     Int
  parentId     Int
  note         String?
  receivedById Int?
  method       PaymentMethod @default(EFECTIVO)
  schoolId     Int
  school       School        @relation(fields: [schoolId], references: [id])
  charge       Charge        @relation(fields: [chargeId], references: [id])
  parent       Parent        @relation(fields: [parentId], references: [id])

  @@unique([reference, schoolId])
  @@index([parentId])
  @@index([schoolId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  parentId  Int
  sentById  Int
  schoolId  Int
  school    School           @relation(fields: [schoolId], references: [id])
  parent    Parent           @relation(fields: [parentId], references: [id])
  sentBy    User             @relation("NotificationSender", fields: [sentById], references: [id])

  @@index([parentId])
  @@index([schoolId])
}

model Meeting {
  id          Int          @id @default(autoincrement())
  title       String
  date        DateTime
  courseId    Int
  createdById Int
  createdAt   DateTime     @default(now())
  schoolId    Int
  school      School       @relation(fields: [schoolId], references: [id])
  attendances Attendance[]
  course      Course       @relation(fields: [courseId], references: [id])
  createdBy   User         @relation("MeetingCreator", fields: [createdById], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  meetingId Int
  parentId  Int
  present   Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  parent    Parent   @relation(fields: [parentId], references: [id])

  @@unique([meetingId, parentId])
}

enum ConvocatoriaKind {
  ORDINARIA
  EMERGENCIA
  ACTIVIDAD
}

enum ConvocatoriaAudience {
  DELEGADOS
  DIRECTORIO
  TODOS_LOS_PADRES
}

// Convocatoria de la Junta Escolar (asamblea ordinaria/emergencia o actividad
// planificada) — a diferencia de Meeting (siempre atado a un solo Course, con
// asistencia por Parent), acá el destinatario puede ser todo el directorio o
// todos los delegados del colegio, y no todo asistente es necesariamente un
// Parent (un directivo lo es siempre por regla de negocio, pero la identidad
// que se registra es el User, ver ConvocatoriaAttendance).
model Convocatoria {
  id          Int                      @id @default(autoincrement())
  title       String
  description String?
  kind        ConvocatoriaKind         @default(ORDINARIA)
  audience    ConvocatoriaAudience
  date        DateTime
  location    String?
  // Monto de la multa por inasistencia, definido al crear — permite que el
  // cobro al cerrar la convocatoria sea automático, sin pedir el monto de nuevo.
  multaAmount Float?
  isCancelled Boolean                  @default(false)
  // Una vez cerrada (asistencia tomada + multas generadas) queda de solo
  // lectura — evita reabrir y generar doble cobro.
  isClosed    Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  createdById Int
  schoolId    Int
  school      School                   @relation(fields: [schoolId], references: [id])
  createdBy   User                     @relation("ConvocatoriaCreator", fields: [createdById], references: [id])
  attendances ConvocatoriaAttendance[]
}

model ConvocatoriaAttendance {
  id             Int          @id @default(autoincrement())
  convocatoriaId Int
  userId         Int
  present        Boolean      @default(false)
  // Si ya se generó el Charge de multa para este ausente (evita doble cobro).
  charged        Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())
  convocatoria   Convocatoria @relation(fields: [convocatoriaId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([convocatoriaId, userId])
}

model Nota {
  id             Int        @id @default(autoincrement())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  studentId      Int
  subjectId      Int
  courseId       Int
  teacherId      Int
  trimesterId    Int
  autoEvaluacion Float?
  cerrado        Boolean    @default(false)
  hacer          Float?
  saber          Float?
  ser            Float?
  total          Float?
  schoolId       Int
  school         School     @relation(fields: [schoolId], references: [id])
  course         Course     @relation(fields: [courseId], references: [id])
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject    @relation(fields: [subjectId], references: [id])
  teacher        Teacher    @relation(fields: [teacherId], references: [id])
  trimester      Trimester  @relation(fields: [trimesterId], references: [id])
  items          NotaItem[]

  @@unique([studentId, subjectId, courseId, trimesterId])
  @@index([studentId])
  @@index([schoolId])
}

model NotaItem {
  id         Int           @id @default(autoincrement())
  dimension  NotaDimension
  titulo     String
  puntaje    Float
  maxPuntaje Float
  fecha      DateTime?
  createdAt  DateTime      @default(now())
  notaId     Int
  taskId     Int?
  nota       Nota          @relation(fields: [notaId], references: [id], onDelete: Cascade)
  task       Task?         @relation(fields: [taskId], references: [id])
}

model GateRecord {
  id             Int            @id @default(autoincrement())
  type           GateRecordType
  action         GateAction
  teacherId      Int?
  visitorName    String?
  visitorCI      String?
  reason         String?
  destination    String?
  registeredById Int?
  note           String?
  createdAt      DateTime       @default(now())
  staffId        Int?
  method         String         @default("MANUAL")
  studentId      Int?
  schoolId       Int
  school         School         @relation(fields: [schoolId], references: [id])
  staff          Staff?         @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher        Teacher?       @relation(fields: [teacherId], references: [id])
  student        Student?       @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model StudentAttendance {
  id             Int                     @id @default(autoincrement())
  date           DateTime
  status         StudentAttendanceStatus @default(PRESENTE)
  note           String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  studentId      Int
  courseId       Int
  teacherId      Int
  academicYearId Int
  schoolId       Int
  school         School                  @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id])
  course         Course                  @relation(fields: [courseId], references: [id])
  student        Student                 @relation(fields: [studentId], references: [id])
  teacher        Teacher                 @relation(fields: [teacherId], references: [id])

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([schoolId])
}

model BiometricTemplate {
  id        Int      @id @default(autoincrement())
  template  String
  deviceId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  teacherId Int?
  staffId   Int?
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// Acta de aprobación del Plan Operativo Anual (POA) de la Junta Escolar — sustento
// legal exigido por el Director Distrital para que la Junta pueda cobrar a los
// padres de familia (tesorería). Puramente informativo: se guarda como respaldo,
// no bloquea la creación de cobros aunque no exista un acta cargada.
model PoaActa {
  id              Int      @id @default(autoincrement())
  schoolId        Int
  academicYear    Int
  actaFileUrl     String
  assemblyDate    DateTime
  montoGlobal     Float
  montoIndividual Float?
  items           String
  createdAt       DateTime @default(now())
  createdByUserId Int
  school          School   @relation(fields: [schoolId], references: [id])
  createdBy       User     @relation(fields: [createdByUserId], references: [id])

  @@unique([schoolId, academicYear])
}

model Comunicado {
  id          Int            @id @default(autoincrement())
  title       String
