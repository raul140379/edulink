generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchoolSchedule {
  id             Int      @id @default(autoincrement())
  shift          String
  name           String
  exitTime       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  breakAfter     String   @default("2,4")
  breakDuration  Int      @default(15)
  isWinter       Boolean  @default(false)
  periodDuration Int      @default(40)
  periods        Int      @default(7)
  startTime      String
}

model User {
  id                Int            @id @default(autoincrement())
  email             String         @unique
  password          String
  role              Role
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  juntaMember       JuntaMember?
  meetingsCreated   Meeting[]      @relation("MeetingCreator")
  notificationsSent Notification[] @relation("NotificationSender")
  parentDelegate    Parent?        @relation("ParentDelegate")
  parent            Parent?        @relation("ParentUser")
  director          ShiftDirector?
  staff             Staff?
  student           Student?
  teacherTutor      Teacher?       @relation("TeacherTutor")
  teacher           Teacher?       @relation("TeacherUser")
}

model JuntaMember {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  ci           String?   @unique
  phone        String?
  juntaRole    JuntaRole @default(VOCAL)
  academicYear Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id])
}

model ShiftDirector {
  id      Int      @id @default(autoincrement())
  shift   Shift    @unique
  userId  Int      @unique
  courses Course[]
  user    User     @relation(fields: [userId], references: [id])
}

model AcademicYear {
  id                 Int                         @id @default(autoincrement())
  year               Int                         @unique
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean                     @default(false)
  createdAt          DateTime                    @default(now())
  charges            Charge[]
  holidays           Holiday[]
  schedules          Schedule[]
  schedulePlans      SchedulePlan[]
  assignments        StudentAcademicAssignment[]
  studentAttendances StudentAttendance[]
  trimesters         Trimester[]
}

model Trimester {
  id             Int          @id @default(autoincrement())
  number         Int
  name           String?
  startDate      DateTime
  endDate        DateTime
  academicYearId Int
  isClosed       Boolean      @default(false)
  notas          Nota[]
  tasks          Task[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, number])
}

model Holiday {
  id             Int          @id @default(autoincrement())
  date           DateTime
  description    String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
}

model Parent {
  id             Int             @id @default(autoincrement())
  firstName      String
  lastName       String
  ci             String?         @unique
  phone          String?
  address        String?
  email          String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         Int?            @unique
  delegateUserId Int?            @unique
  attendances    Attendance[]
  charges        Charge[]
  delegateCourse Course?         @relation("CourseDelegate")
  notifications  Notification[]
  delegateUser   User?           @relation("ParentDelegate", fields: [delegateUserId], references: [id])
  user           User?           @relation("ParentUser", fields: [userId], references: [id])
  students       ParentStudent[]
  payments       Payment[]
}

model Student {
  id                 Int                         @id @default(autoincrement())
  firstName          String
  lastName           String
  ci                 String?                     @unique
  rude               String?                     @unique
  birthDate          DateTime?
  phone              String?
  email              String?                     @unique
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  userId             Int?                        @unique
  address            String?
  gender             Gender                      @default(MASCULINO)
  kardex             String?
  charges            Charge[]
  notas              Nota[]
  parents            ParentStudent[]
  user               User?                       @relation(fields: [userId], references: [id])
  assignments        StudentAcademicAssignment[]
  studentAttendances StudentAttendance[]
  taskSubmissions    TaskSubmission[]
  gateRecords        GateRecord[]
}

model ParentStudent {
  id           Int          @id @default(autoincrement())
  relationType RelationType @default(OTRO)
  isTutor      Boolean      @default(false)
  parentId     Int
  studentId    Int
  parent       Parent       @relation(fields: [parentId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model Teacher {
  id                 Int                    @id @default(autoincrement())
  firstName          String
  lastName           String
  ci                 String?                @unique
  phone              String?
  email              String?                @unique
  specialty          String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  userId             Int                    @unique
  birthDate          DateTime?
  hoursLoad          Int?
  gender             String?
  tutorUserId        Int?                   @unique
  attendanceCode     String?                @unique
  entryTime          String?
  exitTime           String?
  toleranceMin       Int                    @default(10)
  biometricTemplate  BiometricTemplate[]
  tutorCourse        CourseTutor?
  gateRecords        GateRecord[]
  notas              Nota[]
  studentAttendances StudentAttendance[]
  tasks              Task[]
  tutorUser          User?                  @relation("TeacherTutor", fields: [tutorUserId], references: [id])
  user               User                   @relation("TeacherUser", fields: [userId], references: [id])
  attendances        TeacherAttendance[]
  specialties        TeacherSpecialty[]
  assignments        TeacherSubjectCourse[]
}

model TeacherSpecialty {
  id        Int     @id @default(autoincrement())
  teacherId Int
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model TeacherAttendance {
  id        Int              @id @default(autoincrement())
  teacherId Int
  date      DateTime         @default(now())
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENTE)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  teacher   Teacher          @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

model Staff {
  id                Int                 @id @default(autoincrement())
  firstName         String
  lastName          String
  ci                String?             @unique
  phone             String?
  staffRole         StaffRole
  shift             Shift?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  userId            Int                 @unique
  attendanceCode    String?             @unique
  biometricTemplate BiometricTemplate[]
  gateRecord        GateRecord[]
  user              User                @relation(fields: [userId], references: [id])
}

model Course {
  id                 Int                         @id @default(autoincrement())
  level              AcademicLevel
  grade              Grade
  parallel           Parallel
  educationType      EducationType               @default(REGULAR)
  shift              Shift
  shiftDirectorId    Int?
  delegateId         Int?                        @unique
  delegate           Parent?                     @relation("CourseDelegate", fields: [delegateId], references: [id])
  shiftDirector      ShiftDirector?              @relation(fields: [shiftDirectorId], references: [id])
  tutor              CourseTutor?
  meetings           Meeting[]
  notas              Nota[]
  schedules          Schedule[]
  schedulePlans      SchedulePlan[]
  assignments        StudentAcademicAssignment[]
  studentAttendances StudentAttendance[]
  tasks              Task[]
  teacherSubjects    TeacherSubjectCourse[]

  @@unique([level, grade, parallel, educationType, shift])
}

model CourseTutor {
  id        Int      @id @default(autoincrement())
  courseId  Int      @unique
  teacherId Int      @unique
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
}

/// /MATERIAL_ESCOLAR
model Subject {
  id                 Int                    @id @default(autoincrement())
  name               String
  code               String?
  level              AcademicLevel
  hoursPerWeek       Int                    @default(4)
  campo              CampoSaber?
  isActive           Boolean                @default(true)
  notas              Nota[]
  gradeConfigs       SubjectGradeConfig[]
  tasks              Task[]
  teacherSpecialties TeacherSpecialty[]
  teacherSubjects    TeacherSubjectCourse[]

  @@unique([name, level])
}

model SubjectGradeConfig {
  id            Int           @id @default(autoincrement())
  subjectId     Int
  grade         Grade
  hoursPerWeek  Int
  educationType EducationType @default(REGULAR)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, grade, educationType])
}

model TeacherSubjectCourse {
  id            Int            @id @default(autoincrement())
  teacherId     Int
  subjectId     Int
  courseId      Int
  schedules     Schedule[]
  schedulePlans SchedulePlan[]
  course        Course         @relation(fields: [courseId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  teacher       Teacher        @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, subjectId, courseId])
}

model Task {
  id            Int              @id @default(autoincrement())
  title         String
  description   String?
  type          TaskType
  maxScore      Float
  dueDate       DateTime?
  courseId      Int
  subjectId     Int
  teacherId     Int
  trimesterId   Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  attachmentUrl String?
  notaItems     NotaItem[]
  course        Course           @relation(fields: [courseId], references: [id])
  subject       Subject          @relation(fields: [subjectId], references: [id])
  teacher       Teacher          @relation(fields: [teacherId], references: [id])
  trimester     Trimester?       @relation(fields: [trimesterId], references: [id])
  submissions   TaskSubmission[]
}

model TaskSubmission {
  id        Int        @id @default(autoincrement())
  taskId    Int
  studentId Int
  score     Float?
  note      String?
  status    TaskStatus @default(PENDIENTE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  student   Student    @relation(fields: [studentId], references: [id])
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
}

model StudentAcademicAssignment {
  id             Int           @id @default(autoincrement())
  educationType  EducationType
  year           Int
  studentId      Int
  courseId       Int
  academicYearId Int
  createdAt      DateTime      @default(now())
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  course         Course        @relation(fields: [courseId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYearId, educationType])
}

model Schedule {
  id                     Int                  @id @default(autoincrement())
  dayOfWeek              Int
  startTime              String
  endTime                String
  courseId               Int
  teacherSubjectCourseId Int
  academicYearId         Int
  period                 Int
  status                 String               @default("BORRADOR")
  classroomId            Int?
  academicYear           AcademicYear         @relation(fields: [academicYearId], references: [id])
  classroom              Classroom?           @relation(fields: [classroomId], references: [id])
  course                 Course               @relation(fields: [courseId], references: [id])
  teacherSubjectCourse   TeacherSubjectCourse @relation(fields: [teacherSubjectCourseId], references: [id])

  @@unique([courseId, academicYearId, dayOfWeek, period])
}

model SchedulePlan {
  id                     Int                  @id @default(autoincrement())
  dayOfWeek              Int
  period                 Int
  startTime              String
  endTime                String
  courseId               Int
  academicYearId         Int
  teacherSubjectCourseId Int
  classroomId            Int?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  slot                   String               @default("TEMP")
  academicYear           AcademicYear         @relation(fields: [academicYearId], references: [id])
  classroom              Classroom?           @relation(fields: [classroomId], references: [id])
  course                 Course               @relation(fields: [courseId], references: [id])
  teacherSubjectCourse   TeacherSubjectCourse @relation(fields: [teacherSubjectCourseId], references: [id])

  @@unique([courseId, academicYearId, dayOfWeek, period, slot])
}

model Classroom {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  capacity      Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  schedules     Schedule[]
  schedulePlans SchedulePlan[]
}

model Charge {
  id             Int          @id @default(autoincrement())
  title          String
  description    String?
  amount         Float
  paidAmount     Float        @default(0)
  type           ChargeType
  status         ChargeStatus @default(PENDIENTE)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  parentId       Int
  academicYearId Int
  studentId      Int?
  target         ChargeTarget @default(TUTOR)
  tolerance      Boolean      @default(false)
  toleranceNote  String?
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  parent         Parent       @relation(fields: [parentId], references: [id])
  student        Student?     @relation(fields: [studentId], references: [id])
  payments       Payment[]
}

model Payment {
  id           Int           @id @default(autoincrement())
  amount       Float
  reference    String?
  date         DateTime      @default(now())
  createdAt    DateTime      @default(now())
  chargeId     Int
  parentId     Int
  note         String?
  receivedById Int?
  method       PaymentMethod @default(EFECTIVO)
  charge       Charge        @relation(fields: [chargeId], references: [id])
  parent       Parent        @relation(fields: [parentId], references: [id])
}

model Notification {
  id        Int              @id @default(autoincrement())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  parentId  Int
  sentById  Int
  parent    Parent           @relation(fields: [parentId], references: [id])
  sentBy    User             @relation("NotificationSender", fields: [sentById], references: [id])
}

model Meeting {
  id          Int          @id @default(autoincrement())
  title       String
  date        DateTime
  courseId    Int
  createdById Int
  createdAt   DateTime     @default(now())
  attendances Attendance[]
  course      Course       @relation(fields: [courseId], references: [id])
  createdBy   User         @relation("MeetingCreator", fields: [createdById], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  meetingId Int
  parentId  Int
  present   Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  parent    Parent   @relation(fields: [parentId], references: [id])

  @@unique([meetingId, parentId])
}

model Nota {
  id             Int        @id @default(autoincrement())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  studentId      Int
  subjectId      Int
  courseId       Int
  teacherId      Int
  trimesterId    Int
  autoEvaluacion Float?
  cerrado        Boolean    @default(false)
  hacer          Float?
  saber          Float?
  ser            Float?
  total          Float?
  course         Course     @relation(fields: [courseId], references: [id])
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject    @relation(fields: [subjectId], references: [id])
  teacher        Teacher    @relation(fields: [teacherId], references: [id])
  trimester      Trimester  @relation(fields: [trimesterId], references: [id])
  items          NotaItem[]

  @@unique([studentId, subjectId, courseId, trimesterId])
}

model NotaItem {
  id         Int           @id @default(autoincrement())
  dimension  NotaDimension
  titulo     String
  puntaje    Float
  maxPuntaje Float
  fecha      DateTime?
  createdAt  DateTime      @default(now())
  notaId     Int
  taskId     Int?
  nota       Nota          @relation(fields: [notaId], references: [id], onDelete: Cascade)
  task       Task?         @relation(fields: [taskId], references: [id])
}

model GateRecord {
  id             Int            @id @default(autoincrement())
  type           GateRecordType
  action         GateAction
  teacherId      Int?
  visitorName    String?
  visitorCI      String?
  reason         String?
  destination    String?
  registeredById Int?
  note           String?
  createdAt      DateTime       @default(now())
  staffId        Int?
  method         String         @default("MANUAL")
  studentId      Int?
  staff          Staff?         @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher        Teacher?       @relation(fields: [teacherId], references: [id])
  student        Student?       @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model StudentAttendance {
  id             Int                     @id @default(autoincrement())
  date           DateTime
  status         StudentAttendanceStatus @default(PRESENTE)
  note           String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  studentId      Int
  courseId       Int
  teacherId      Int
  academicYearId Int
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id])
  course         Course                  @relation(fields: [courseId], references: [id])
  student        Student                 @relation(fields: [studentId], references: [id])
  teacher        Teacher                 @relation(fields: [teacherId], references: [id])

  @@unique([studentId, courseId, date])
}

model BiometricTemplate {
  id        Int      @id @default(autoincrement())
  template  String
  deviceId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  teacherId Int?
  staffId   Int?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum Role {
  SUPER_ADMIN
  DIRECTOR
  REGENTE
  TEACHER
  DELEGATE
  PARENT
  STUDENT
  STUDENT_GOV
  STAFF
  SECRETARY
  JUNTA_ESCOLAR
  TEACHER_TUTOR
  PORTERO
}

enum AcademicLevel {
  INICIAL
  PRIMARIA
  SECUNDARIA
}

enum CampoSaber {
  VIDA_TIERRA_TERRITORIO
  COMUNIDAD_SOCIEDAD
  COSMOS_PENSAMIENTO
  CIENCIA_TECNOLOGIA_PRODUCCION
}

enum Gender {
  MASCULINO
  FEMENINO
}

enum EducationType {
  REGULAR
  BTH
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum Parallel {
  A
  B
  C
}

enum Grade {
  PRIMERO
  SEGUNDO
  TERCERO
  CUARTO
  QUINTO
  SEXTO
}

enum RelationType {
  PADRE
  MADRE
  TUTOR_LEGAL
  OTRO
}

enum StaffRole {
  PORTERO
  SECRETARIA
  REGENTE
  AUXILIAR
  OTRO
  PSICOLOGO
}

enum ChargeTarget {
  TUTOR
  ESTUDIANTE
}

enum ChargeType {
  CUOTA_INICIAL
  DEUDA_ANTERIOR
  MULTA_ASAMBLEA
  MINGA
  MULTA_REUNION
  ACTIVIDAD
  MATERIAL_ESCOLAR
  OTRO
}

enum ChargeStatus {
  PENDIENTE
  PARCIAL
  PAGADO
  ANULADO
}

enum PaymentMethod {
  EFECTIVO
  DEPOSITO_BANCARIO
  QR
  TRANSFERENCIA
  OTRO
}

enum NotificationType {
  REUNION
  ACTIVIDAD
  DEUDA
  ACADEMICA
  GENERAL
}

enum JuntaRole {
  PRESIDENTE
  VICEPRESIDENTE
  SECRETARIA
  TESORERO
  VOCAL
}

/// TIPO DE ASISTENCIA
enum AttendanceStatus {
  PRESENTE
  AUSENTE
  RETRASO
  LICENCIA
}

enum TaskType {
  EVALUACION
  TRABAJO
  SER
  DECIDIR
}

enum TaskStatus {
  PENDIENTE
  CALIFICADO
}

enum NotaDimension {
  SABER
  HACER
}

enum GateRecordType {
  MAESTRO
  VISITANTE
  ADMINISTRATIVO
  ESTUDIANTE
}

enum GateAction {
  ENTRADA
  SALIDA
}

enum StudentAttendanceStatus {
  PRESENTE
  AUSENTE
  RETRASO
  LICENCIA
}
